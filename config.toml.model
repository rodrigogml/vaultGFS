# vaultGFS configuration model
#
# Cron-like schedule format:
# minute hour day-of-month month day-of-week
# Examples:
# 0 1 * * * every day at 01:00
# 30 2 * * 0 every Sunday at 02:30
# 0 3 1 * * first day of each month at 03:00
# 0 1,13 * * * every day at 01:00 and 13:00

# Defaults applied to all jobs unless overridden
[defaults]
# Diretório de estado do vaultGFS (locks, arquivos auxiliares, etc.)
state_dir = "/var/lib/vaultgfs"
# Caminho do catálogo SQLite que registra execuções e snapshots
catalog = "/var/lib/vaultgfs/catalog.db"
# Raiz padrão para backups; jobs podem usar destinos específicos
destination_root = "/mnt/usb1/backups"
# Usuário do sistema recomendado para rodar os backups
run_user = "vaultgfs"
# Grupo do sistema recomendado para rodar os backups
run_group = "vaultgfs"
# Nível padrão de compressão zstd (1–22); pode ser sobrescrito por job
compression_level = 22
# Threads padrão de compressão zstd; 1 ou 2 geralmente é suficiente
compression_threads = 2
# Número máximo de backups rodando ao mesmo tempo (fila global)
max_concurrent_backups = 1
# Intervalo (segundos) entre tentativas de pegar um slot de backup
lock_wait_seconds = 10
# Agendamento da limpeza de retenção via vaultgfs-prune --apply
prune_schedule = "0 20 * * 0"

# Extensões tratadas como "storage" (já comprimidas ou pouco compressíveis)
storage_extensions = [
 ".jpg", ".jpeg", ".png", ".gif", ".webp", ".avif",
 ".mp4", ".mov", ".avi", ".mpg", ".mpeg", ".mkv",
 ".mp3", ".wav", ".flac",
 ".zip", ".rar", ".7z", ".gz", ".bz2", ".xz", ".zst",
 ".jar", ".war", ".ear", ".pdf", ".psd", ".img", ".iso",
 ".exe", ".msi", ".apk"
]

# Retenção padrão para jobs filesystem-gfs.
# G = full, F = diff, S = inc. A retenção é por contagem de backups
# bem-sucedidos mais recentes. Pais e avós necessários para restauração são
# preservados automaticamente, mesmo quando excederem a contagem direta.
[defaults.retention.filesystem_gfs]
keep_full = 12
keep_diff = 3
keep_inc = 60

# Retenção padrão para jobs mysql-dump.
# Dumps são independentes; o prune mantém o dump mais recente de cada dia,
# semana domingo-sábado e mês civil, deduplicando quando um arquivo cair em
# mais de uma categoria.
[defaults.retention.mysql_dump]
keep_daily = 14
keep_weekly = 8
keep_monthly = 12

[defaults.retention.pfsense_config]
keep_daily = 30
keep_weekly = 26
keep_monthly = 24

# Configuração padrão de conexão MySQL para todos os jobs mysql-dump
[mysql]
# Host MySQL usado quando socket não for informado
host = "localhost"
# Porta MySQL usada quando socket não for informado
port = 3306
# Usuário MySQL usado pelos dumps (conceda apenas permissões de leitura)
user = "vaultGFS"
# Senha do usuário MySQL (não commitar a versão real deste arquivo)
password = "CHANGE_ME"
# Socket local do MySQL; tem prioridade sobre host/porta quando definido
socket = "/var/run/mysqld/mysqld.sock"
# Modo SSL para o cliente MySQL (por exemplo, DISABLED, REQUIRED)
ssl_mode = "DISABLED"

# ----------------------------
# Optional NotiCLI notifications
# ----------------------------
# NotiCLI project and setup reference:
# https://github.com/rodrigogml/NotiCLI
#
# Install/configure NotiCLI separately and make sure the executable is available
# as `noticli` on the system PATH for the user that runs vaultGFS.
# vaultGFS calls:
# noticli send [--config <path>] --sender <text> --category <SUCCESS|FAIL> [--priority <HIGH|NORMAL|LOW>] --title <text> --message <text>
#
# The NotiCLI config file defines destinations, delivery accounts, routes and
# channel secrets. Do not put NotiCLI secrets in this vaultGFS config unless the
# NotiCLI project explicitly supports that in a future version.
[notifications.noticli]
# If true, vaultGFS calls `noticli send` after backup executions.
# The `noticli` executable must be available on the system PATH.
enabled = false

# Optional NotiCLI config path passed as `--config`.
# If omitted, NotiCLI uses its own default config lookup.
# config = "/opt/NotiCLI/config/noticli.json"

# Sender identifier accepted by NotiCLI and used for filtering notifications.
# Keep it at 20 characters or less.
# sender = "vaultGFS"

# Category passed to NotiCLI for routing. Defaults should distinguish success and failure.
category = "SUCCESS"

# Optional NotiCLI priority. Leave unset for successful notifications so NotiCLI uses NORMAL.
# priority = "NORMAL"

# Title and message may use these vaultGFS placeholders:
# {job_name}, {job_type}, {level}, {status}, {started_at}, {ended_at},
# {duration_seconds}, {summary}
# title = "vaultGFS backup {status}: {job_name}"

# Message is optional. If omitted, vaultGFS renders a default execution summary.
# message = "job={job_name} type={job_type} level={level} status={status} started={started_at} ended={ended_at} duration_seconds={duration_seconds} summary={summary}"

[notifications.noticli.failure]
# Failure-specific values override only the fields defined here when the backup
# status is failed. Use this to mark failures as high priority and route them
# through NotiCLI rules.
category = "FAIL"
priority = "HIGH"

# title = "vaultGFS BACKUP FAILED: {job_name}"

# ----------------------------
# Definição de um job de backup
# Exemplo: filesystem com GFS (full/diff/inc)
# ----------------------------
[[jobs]]
# Nome único do job (usado em logs, catálogo e nomes de diretório)
name = "example-filesystem"
# Se false, o job é ignorado pelo vaultgfs-backup
enabled = true
# Tipo do job: use "filesystem-gfs" para backup de diretórios
type = "filesystem-gfs"
# Diretório de origem a ser protegido por este job
source = "/path/to/source"
# Diretório onde os backups deste job serão escritos
destination = "/mnt/usb1/backups/example-filesystem"
# Se true, evita novo backup quando nenhum arquivo mudou desde o último snapshot
skip_if_unchanged = true
# Nível de compressão zstd específico deste job (opcional)
compression_level = 22
# Agendamento sugerido (cron) para backups FULL deste job
schedule_full = "0 3 1 * *"
# Agendamento sugerido (cron) para backups diferenciais (DIFF) deste job
schedule_diff = "0 2 * * 0"
# Agendamento sugerido (cron) para backups incrementais (INC) deste job
schedule_inc = "0 1 * * *"

# Optional retention override for this job.
[jobs.retention]
# keep_full = 12
# keep_diff = 3
# keep_inc = 60

# Optional NotiCLI override for this job.
# Omitted fields inherit the corresponding global setting.
[jobs.notifications.noticli]
# enabled = false disables notifications only for this job.
# enabled = true enables notifications for this job when global notifications
# are disabled, as long as the effective required fields exist.
# enabled = true

# Use job overrides to route this job differently through NotiCLI category rules.
# category = "FILESYSTEM"

[jobs.notifications.noticli.failure]
# Failure-specific job overrides inherit unspecified values from the job default,
# then from the global failure/default settings.
# title = "Filesystem backup failed: {job_name}"

# category = "FAIL"
# priority = "HIGH"

# ----------------------------
# Definição de um job MySQL
# Exemplo: dump lógico de um schema
# ----------------------------
[[jobs]]
# Nome único do job MySQL
name = "example-mysql-schema"
# Se false, o job é ignorado
enabled = true
# Tipo do job: use "mysql-dump" para dumps lógicos de schema(s) MySQL
type = "mysql-dump"
# Lista de schemas MySQL a serem exportados por este job
schemas = ["example_schema"]
# Diretório onde os arquivos .sql.zst deste job serão gravados
destination = "/mnt/usb1/backups/mysql/example_schema"
# Dumps normalmente não usam skip_if_unchanged; deixe false
skip_if_unchanged = false
# Nível de compressão zstd específico deste job
compression_level = 22
# Agendamento sugerido (cron) diário para este dump MySQL
schedule = "0 4 * * *"

# Optional retention override for this job.
# [jobs.retention]
# keep_daily = 14
# keep_weekly = 8
# keep_monthly = 12

# ----------------------------
# Definição de um job pfSense
# Exemplo: download do XML de configuração pela WebGUI
# ----------------------------
[[jobs]]
name = "example-pfsense"
enabled = false
type = "pfsense-config"
base_url = "https://192.168.1.1"
username = "vaultGFS"
password = "CHANGE_ME"
verify_tls = false
include_rrd = false
destination = "/mnt/usb1/backups/pfsense/example"
compression_level = 22
compression_threads = 1
schedule = "0 4 * * *"

[jobs.retention]
keep_daily = 30
keep_weekly = 26
keep_monthly = 24
